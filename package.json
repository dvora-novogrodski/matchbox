{
  "name": "matchbox",
  "private": true,
  "version": "0.0.0",
  "description": "AI-powered job search workspace: discovery, grounded CV tailoring, and application tracking.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "docker compose up",
    "dev:down": "docker compose down",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=24"
  }
}
