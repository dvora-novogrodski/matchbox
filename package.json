{
  "name": "matchbox",
  "private": true,
  "version": "0.0.0",
  "description": "AI-powered job search workspace: discovery, grounded CV tailoring, and application tracking.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "docker compose up",
    "dev:down": "docker compose down",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:ci": "npm run lint:ci --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true,
    "@nestjs/core": false,
    "cpu-features": false,
    "protobufjs": false,
    "ssh2": false,
    "@firebase/util": false,
    "msw@2.15.0": false
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.1"
  }
}
