# ---- Database ----
POSTGRES_USER=matchbox
POSTGRES_PASSWORD=matchbox
POSTGRES_DB=matchbox
# For the API and Prisma CLI running on the host. Containers in docker compose use the host `db` instead.
DATABASE_URL=postgresql://matchbox:matchbox@localhost:5432/matchbox

# ---- API service ----
API_PORT=3000
# Comma-separated list of allowed browser origins (CORS)
WEB_ORIGIN=http://localhost:5173
AI_SERVICE_URL=http://ai:8000
AI_TIMEOUT_MS=15000
# Encrypts integration tokens (e.g. GitHub) at rest. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Optional on the host. Headless Chrome for CV PDFs. Docker Compose sets the image Chromium.
# macOS: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CHROME_PATH=

# ---- Auth (Firebase) ----
FIREBASE_PROJECT_ID=demo-matchbox
# Native dev with real Firebase: path to a service account JSON.
# Docker Compose uses its bundled Auth emulator instead.
GOOGLE_APPLICATION_CREDENTIALS=
# Native dev with the emulator:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Native web dev with the emulator:
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ---- Web ----
VITE_API_URL=http://localhost:3000

# ---- AI service / worker ----
AI_PORT=8000
LLM_PROVIDER=ollama            # ollama | gemini
OLLAMA_BASE_URL=http://ollama:11434
GEMINI_API_KEY=
# Local task dispatcher (dev) or cloud-tasks (prod)
TASK_QUEUE_BACKEND=local
WORKER_URL=http://worker:8001

# ---- Plans (overridable limits, section 4.4) ----
PLAN_OWNER_DISCOVER_DAY_INTERVAL_HOURS=2
PLAN_OWNER_DISCOVER_NIGHT_INTERVAL_HOURS=6
PLAN_OWNER_DISCOVER_QUIET_HOURS=00:00-07:00
PLAN_OWNER_AI_DAILY_CALL_BUDGET=200
