# ---- Database ----
POSTGRES_USER=matchbox
POSTGRES_PASSWORD=matchbox
POSTGRES_DB=matchbox
DATABASE_URL=postgresql://matchbox:matchbox@db:5432/matchbox

# ---- API service ----
API_PORT=3000
AI_SERVICE_URL=http://ai:8000
AI_TIMEOUT_MS=15000
# Encrypts integration tokens (e.g. GitHub) at rest. Generate a 32-byte base64 key.
TOKEN_ENCRYPTION_KEY=

# ---- Auth (Firebase) ----
FIREBASE_PROJECT_ID=
# Local dev: path to service account JSON, or use the Firebase emulator
GOOGLE_APPLICATION_CREDENTIALS=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# ---- Web ----
VITE_API_URL=http://localhost:3000

# ---- AI service / worker ----
AI_PORT=8000
LLM_PROVIDER=ollama            # ollama | gemini
OLLAMA_BASE_URL=http://ollama:11434
GEMINI_API_KEY=
# Local task dispatcher (dev) or cloud-tasks (prod)
TASK_QUEUE_BACKEND=local
WORKER_URL=http://worker:8001

# ---- Plans (overridable limits, section 4.4) ----
PLAN_OWNER_DISCOVER_DAY_INTERVAL_HOURS=2
PLAN_OWNER_DISCOVER_NIGHT_INTERVAL_HOURS=6
PLAN_OWNER_DISCOVER_QUIET_HOURS=00:00-07:00
PLAN_OWNER_AI_DAILY_CALL_BUDGET=200
