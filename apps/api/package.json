{
  "name": "@matchbox/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prebuild": "npm run build -w @matchbox/shared",
    "build": "nest build",
    "prestart": "npm run build -w @matchbox/shared",
    "start": "nest start",
    "prestart:dev": "npm run build -w @matchbox/shared",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint src test --fix",
    "lint:ci": "eslint src test --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json --noEmit",
    "test": "jest --selectProjects unit",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed-demo": "npx tsx scripts/seed-demo-data.ts"
  },
  "dependencies": {
    "@matchbox/shared": "*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/terminus": "^11.1.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "firebase-admin": "^14.5.0",
    "nestjs-zod": "^5.5.0",
    "puppeteer-core": "^25.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.19.1",
    "dotenv": "^18.0.5",
    "jest": "^29.7.0",
    "prisma": "^7.10.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.9.3"
  }
}
